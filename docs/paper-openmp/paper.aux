\@writefile{toc}{\contentsline {section}{\numberline {4}Parallel Reachability with a Shared Visited Set}{4}{section.4}\protected@file@percent }
\newlabel{sec:approach}{{4}{4}{Parallel Reachability with a Shared Visited Set}{section.4}{}}
\newlabel{sec:approach@cref}{{[section][4][]4}{[1][4][]4}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}One level of the search}{4}{subsection.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Why insertion is fused into expansion}{4}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Sequential versus parallel insertion. Sequentially one worker drains the whole frontier and every successor enters the same visited set. In parallel each thread takes a slice and inserts its own successors; because a discrete key selects one stripe, threads writing to different stripes (shaded) never wait for each other, and the lock is held only for the stripe being touched.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{5}{Sequential versus parallel insertion. Sequentially one worker drains the whole frontier and every successor enters the same visited set. In parallel each thread takes a slice and inserts its own successors; because a discrete key selects one stripe, threads writing to different stripes (shaded) never wait for each other, and the lock is held only for the stripe being touched}{figure.caption.3}{}}
\newlabel{fig:pipeline@cref}{{[figure][2][]2}{[1][4][]5}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Partitioned ownership needs three writes per successor --- into a buffer, out of it during routing, and into a shard --- because a thread may not write outside its own shard. Fusing expansion and insertion removes the buffer and the routing pass, and each successor is written once.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:dataflow}{{3}{5}{Partitioned ownership needs three writes per successor --- into a buffer, out of it during routing, and into a shard --- because a thread may not write outside its own shard. Fusing expansion and insertion removes the buffer and the routing pass, and each successor is written once}{figure.caption.4}{}}
\newlabel{fig:dataflow@cref}{{[figure][3][]3}{[1][4][]5}}
