\newlabel{sec:batching}{{5}{7}{Removing the Critical Section}{section.5}{}}
\newlabel{sec:batching@cref}{{[section][5][]5}{[1][7][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Why $\rho $ decides contention. Where a configuration carries a single zone, threads touch distinct antichains and each holds its stripe lock for one comparison. Where a configuration accumulates many zones, threads converge on the same antichain and each holds the lock across a traversal proportional to its length, so the traversals are executed serially. The batched engine performs exactly the same traversals, but after the lock is released.}}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:rho}{{4}{8}{Why $\rho $ decides contention. Where a configuration carries a single zone, threads touch distinct antichains and each holds its stripe lock for one comparison. Where a configuration accumulates many zones, threads converge on the same antichain and each holds the lock across a traversal proportional to its length, so the traversals are executed serially. The batched engine performs exactly the same traversals, but after the lock is released}{figure.caption.5}{}}
\newlabel{fig:rho@cref}{{[figure][4][]4}{[1][7][]8}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Evaluation}{8}{section.6}\protected@file@percent }
\newlabel{sec:eval}{{6}{8}{Evaluation}{section.6}{}}
\newlabel{sec:eval@cref}{{[section][6][]6}{[1][7][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Thread schedules on a configuration with a long antichain. Under fusion (a) each insertion holds the stripe lock across a $\Theta (\rho )$ traversal, so threads queue and the traversals are effectively serialised. Under batching (b) insertions are constant-time pushes that barely contend, and the traversals --- now one per configuration per level rather than one per successor --- run concurrently outside any lock.}}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:timeline}{{5}{9}{Thread schedules on a configuration with a long antichain. Under fusion (a) each insertion holds the stripe lock across a $\Theta (\rho )$ traversal, so threads queue and the traversals are effectively serialised. Under batching (b) insertions are constant-time pushes that barely contend, and the traversals --- now one per configuration per level rather than one per successor --- run concurrently outside any lock}{figure.caption.6}{}}
\newlabel{fig:timeline@cref}{{[figure][5][]5}{[1][7][]9}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Explored symbolic states. \textsc  {Ptctlmc}{} reproduces \texttt  {\small  verifyta} exactly on every model and at every thread count. \textsc  {LTSmin}{} explores strictly more because it stores one state per (configuration, zone) pair with no convex-union merging; the factor in parentheses is how many more states it stores, so its timings in \cref  {tab:main} reflect more work by construction.}}{9}{table.caption.8}\protected@file@percent }
\newlabel{tab:parity}{{1}{9}{Explored symbolic states. \tool {} reproduces \code {verifyta} exactly on every model and at every thread count. \ltsmin {} explores strictly more because it stores one state per (configuration, zone) pair with no convex-union merging; the factor in parentheses is how many more states it stores, so its timings in \cref {tab:main} reflect more work by construction}{table.caption.8}{}}
\newlabel{tab:parity@cref}{{[table][1][]1}{[1][9][]9}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Wall-clock seconds (median of two runs) and the speed-up of \textsc  {Ptctlmc}{} over each baseline. \textsf  {T}/\textsf  {M} mark runs stopped by the 30-minute / 15\,GB cap; a speed-up against a capped baseline is a lower bound, written $>$. \textsc  {Ptctlmc}{} is fastest on every row.}}{10}{table.caption.9}\protected@file@percent }
\newlabel{tab:main}{{2}{10}{Wall-clock seconds (median of two runs) and the speed-up of \tool {} over each baseline. \textsf {T}/\textsf {M} mark runs stopped by the 30-minute / 15\,GB cap; a speed-up against a capped baseline is a lower bound, written $>$. \tool {} is fastest on every row}{table.caption.9}{}}
\newlabel{tab:main@cref}{{[table][2][]2}{[1][10][]10}}
