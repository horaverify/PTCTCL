<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
<declaration>broadcast chan cd; clock y;</declaration>
<template><name>P</name>
<location id="p_S"><name>S</name></location>
<location id="p_T"><name>T</name></location>
<init ref="p_S"/>
<transition><source ref="p_S"/><target ref="p_T"/><label kind="synchronisation">cd!</label></transition>
<transition><source ref="p_T"/><target ref="p_T"/></transition>
</template>
<template><name>Q</name>
<location id="q_A"><name>A</name></location>
<location id="q_B"><name>B</name></location>
<init ref="q_A"/>
<transition><source ref="q_A"/><target ref="q_B"/><label kind="synchronisation">cd?</label><label kind="guard">y&gt;=5</label></transition>
<transition><source ref="q_B"/><target ref="q_B"/></transition>
</template>
<system>system P, Q;</system>
</nta>
