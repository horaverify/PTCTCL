<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
<declaration>clock c0,c1,c2,c3; chan take0,take1,take2,take3,put0,put1,put2,put3;</declaration>
<template><name>F0</name>
<location id="f0_free"><name>Free</name></location>
<location id="f0_used"><name>Used</name></location>
<init ref="f0_free"/>
<transition><source ref="f0_free"/><target ref="f0_used"/><label kind="synchronisation">take0?</label></transition>
<transition><source ref="f0_used"/><target ref="f0_free"/><label kind="synchronisation">put0?</label></transition>
</template>
<template><name>F1</name>
<location id="f1_free"><name>Free</name></location>
<location id="f1_used"><name>Used</name></location>
<init ref="f1_free"/>
<transition><source ref="f1_free"/><target ref="f1_used"/><label kind="synchronisation">take1?</label></transition>
<transition><source ref="f1_used"/><target ref="f1_free"/><label kind="synchronisation">put1?</label></transition>
</template>
<template><name>F2</name>
<location id="f2_free"><name>Free</name></location>
<location id="f2_used"><name>Used</name></location>
<init ref="f2_free"/>
<transition><source ref="f2_free"/><target ref="f2_used"/><label kind="synchronisation">take2?</label></transition>
<transition><source ref="f2_used"/><target ref="f2_free"/><label kind="synchronisation">put2?</label></transition>
</template>
<template><name>F3</name>
<location id="f3_free"><name>Free</name></location>
<location id="f3_used"><name>Used</name></location>
<init ref="f3_free"/>
<transition><source ref="f3_free"/><target ref="f3_used"/><label kind="synchronisation">take3?</label></transition>
<transition><source ref="f3_used"/><target ref="f3_free"/><label kind="synchronisation">put3?</label></transition>
</template>
<template><name>P0</name>
<location id="p0_think"><name>Think</name></location>
<location id="p0_holdl"><name>HoldL</name></location>
<location id="p0_eat"><name>Eat</name><label kind="invariant">c0&lt;=2</label></location>
<location id="p0_drop"><name>Dropped</name></location>
<init ref="p0_think"/>
<transition><source ref="p0_think"/><target ref="p0_holdl"/><label kind="synchronisation">take0!</label><label kind="assignment">c0=0</label></transition>
<transition><source ref="p0_holdl"/><target ref="p0_eat"/><label kind="synchronisation">take1!</label><label kind="assignment">c0=0</label></transition>
<transition><source ref="p0_eat"/><target ref="p0_drop"/><label kind="guard">c0&gt;=1</label><label kind="synchronisation">put0!</label></transition>
<transition><source ref="p0_drop"/><target ref="p0_think"/><label kind="synchronisation">put1!</label></transition>
</template>
<template><name>P1</name>
<location id="p1_think"><name>Think</name></location>
<location id="p1_holdl"><name>HoldL</name></location>
<location id="p1_eat"><name>Eat</name><label kind="invariant">c1&lt;=2</label></location>
<location id="p1_drop"><name>Dropped</name></location>
<init ref="p1_think"/>
<transition><source ref="p1_think"/><target ref="p1_holdl"/><label kind="synchronisation">take1!</label><label kind="assignment">c1=0</label></transition>
<transition><source ref="p1_holdl"/><target ref="p1_eat"/><label kind="synchronisation">take2!</label><label kind="assignment">c1=0</label></transition>
<transition><source ref="p1_eat"/><target ref="p1_drop"/><label kind="guard">c1&gt;=1</label><label kind="synchronisation">put1!</label></transition>
<transition><source ref="p1_drop"/><target ref="p1_think"/><label kind="synchronisation">put2!</label></transition>
</template>
<template><name>P2</name>
<location id="p2_think"><name>Think</name></location>
<location id="p2_holdl"><name>HoldL</name></location>
<location id="p2_eat"><name>Eat</name><label kind="invariant">c2&lt;=2</label></location>
<location id="p2_drop"><name>Dropped</name></location>
<init ref="p2_think"/>
<transition><source ref="p2_think"/><target ref="p2_holdl"/><label kind="synchronisation">take2!</label><label kind="assignment">c2=0</label></transition>
<transition><source ref="p2_holdl"/><target ref="p2_eat"/><label kind="synchronisation">take3!</label><label kind="assignment">c2=0</label></transition>
<transition><source ref="p2_eat"/><target ref="p2_drop"/><label kind="guard">c2&gt;=1</label><label kind="synchronisation">put2!</label></transition>
<transition><source ref="p2_drop"/><target ref="p2_think"/><label kind="synchronisation">put3!</label></transition>
</template>
<template><name>P3</name>
<location id="p3_think"><name>Think</name></location>
<location id="p3_holdl"><name>HoldL</name></location>
<location id="p3_eat"><name>Eat</name><label kind="invariant">c3&lt;=2</label></location>
<location id="p3_drop"><name>Dropped</name></location>
<init ref="p3_think"/>
<transition><source ref="p3_think"/><target ref="p3_holdl"/><label kind="synchronisation">take3!</label><label kind="assignment">c3=0</label></transition>
<transition><source ref="p3_holdl"/><target ref="p3_eat"/><label kind="synchronisation">take0!</label><label kind="assignment">c3=0</label></transition>
<transition><source ref="p3_eat"/><target ref="p3_drop"/><label kind="guard">c3&gt;=1</label><label kind="synchronisation">put3!</label></transition>
<transition><source ref="p3_drop"/><target ref="p3_think"/><label kind="synchronisation">put0!</label></transition>
</template>
<system>system F0,F1,F2,F3,P0,P1,P2,P3;</system>
</nta>
