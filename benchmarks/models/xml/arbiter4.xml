<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
<declaration>clock x0,x1,x2,x3; chan acq, rel;</declaration>
<template><name>Arb</name>
<location id="arb_free"><name>Free</name></location>
<location id="arb_busy"><name>Busy</name></location>
<init ref="arb_free"/>
<transition><source ref="arb_free"/><target ref="arb_busy"/><label kind="synchronisation">acq?</label></transition>
<transition><source ref="arb_busy"/><target ref="arb_free"/><label kind="synchronisation">rel?</label></transition>
</template>
<template><name>C0</name>
<location id="c0_idle"><name>idle</name></location>
<location id="c0_want"><name>want</name></location>
<location id="c0_cs"><name>cs</name><label kind="invariant">x0&lt;=4</label></location>
<init ref="c0_idle"/>
<transition><source ref="c0_idle"/><target ref="c0_want"/><label kind="guard">x0&gt;=2</label></transition>
<transition><source ref="c0_want"/><target ref="c0_cs"/><label kind="synchronisation">acq!</label><label kind="assignment">x0=0</label></transition>
<transition><source ref="c0_cs"/><target ref="c0_idle"/><label kind="synchronisation">rel!</label><label kind="assignment">x0=0</label></transition>
</template>
<template><name>C1</name>
<location id="c1_idle"><name>idle</name></location>
<location id="c1_want"><name>want</name></location>
<location id="c1_cs"><name>cs</name><label kind="invariant">x1&lt;=4</label></location>
<init ref="c1_idle"/>
<transition><source ref="c1_idle"/><target ref="c1_want"/><label kind="guard">x1&gt;=2</label></transition>
<transition><source ref="c1_want"/><target ref="c1_cs"/><label kind="synchronisation">acq!</label><label kind="assignment">x1=0</label></transition>
<transition><source ref="c1_cs"/><target ref="c1_idle"/><label kind="synchronisation">rel!</label><label kind="assignment">x1=0</label></transition>
</template>
<template><name>C2</name>
<location id="c2_idle"><name>idle</name></location>
<location id="c2_want"><name>want</name></location>
<location id="c2_cs"><name>cs</name><label kind="invariant">x2&lt;=4</label></location>
<init ref="c2_idle"/>
<transition><source ref="c2_idle"/><target ref="c2_want"/><label kind="guard">x2&gt;=2</label></transition>
<transition><source ref="c2_want"/><target ref="c2_cs"/><label kind="synchronisation">acq!</label><label kind="assignment">x2=0</label></transition>
<transition><source ref="c2_cs"/><target ref="c2_idle"/><label kind="synchronisation">rel!</label><label kind="assignment">x2=0</label></transition>
</template>
<template><name>C3</name>
<location id="c3_idle"><name>idle</name></location>
<location id="c3_want"><name>want</name></location>
<location id="c3_cs"><name>cs</name><label kind="invariant">x3&lt;=4</label></location>
<init ref="c3_idle"/>
<transition><source ref="c3_idle"/><target ref="c3_want"/><label kind="guard">x3&gt;=2</label></transition>
<transition><source ref="c3_want"/><target ref="c3_cs"/><label kind="synchronisation">acq!</label><label kind="assignment">x3=0</label></transition>
<transition><source ref="c3_cs"/><target ref="c3_idle"/><label kind="synchronisation">rel!</label><label kind="assignment">x3=0</label></transition>
</template>
<system>system Arb,C0,C1,C2,C3;</system>
</nta>
