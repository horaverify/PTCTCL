<location id="arb_free"><name>Free</name></location>
<location id="arb_busy"><name>Busy</name></location>
<init ref="arb_free"/>
<transition><source ref="arb_free"/><target ref="arb_busy"/><label kind="synchronisation">acq?</label></transition>
<transition><source ref="arb_busy"/><target ref="arb_free"/><label kind="synchronisation">rel?</label></transition>
</template>
