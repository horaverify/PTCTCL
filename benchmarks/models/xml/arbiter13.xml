<transition><source ref="c0_want"/><target ref="c0_cs"/><label kind="synchronisation">acq!</label><label kind="assignment">x0=0</label></transition>
<transition><source ref="c0_cs"/><target ref="c0_idle"/><label kind="synchronisation">rel!</label><label kind="assignment">x0=0</label></transition>
</template>
