<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
<declaration>clock x0,x1,x2,x3,x4,x5; int[0,6] a; int[0,6] b;</declaration>
<template><name>P0</name>
<location id="p0_idle"><name>idle</name></location>
<location id="p0_reqA"><name>reqA</name><label kind="invariant">x0&lt;=2</label></location>
<location id="p0_waitA"><name>waitA</name></location>
<location id="p0_reqB"><name>reqB</name><label kind="invariant">x0&lt;=2</label></location>
<location id="p0_waitB"><name>waitB</name></location>
<location id="p0_cs"><name>cs</name></location>
<init ref="p0_idle"/>
<transition><source ref="p0_idle"/><target ref="p0_reqA"/><label kind="guard">a==0</label><label kind="assignment">x0=0</label></transition>
<transition><source ref="p0_reqA"/><target ref="p0_waitA"/><label kind="assignment">a=1, x0=0</label></transition>
<transition><source ref="p0_waitA"/><target ref="p0_reqB"/><label kind="guard">x0&gt;2 &amp;&amp; a==1 &amp;&amp; b==0</label><label kind="assignment">x0=0</label></transition>
<transition><source ref="p0_waitA"/><target ref="p0_idle"/><label kind="guard">x0&gt;2 &amp;&amp; a!=1</label></transition>
<transition><source ref="p0_reqB"/><target ref="p0_waitB"/><label kind="assignment">b=1, x0=0</label></transition>
<transition><source ref="p0_waitB"/><target ref="p0_cs"/><label kind="guard">x0&gt;2 &amp;&amp; b==1</label></transition>
<transition><source ref="p0_waitB"/><target ref="p0_idle"/><label kind="guard">x0&gt;2 &amp;&amp; b!=1</label><label kind="assignment">a=0</label></transition>
<transition><source ref="p0_cs"/><target ref="p0_idle"/><label kind="assignment">a=0, b=0</label></transition>
</template>
