<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
<declaration>clock y0,y1,y2,y3,y4,y5, c; broadcast chan cd; chan begin, end;</declaration>
<template><name>Bus</name>
<location id="bus_idle"><name>Idle</name></location>
<location id="bus_active"><name>Active</name><label kind="invariant">c&lt;=1</label></location>
<location id="bus_tx"><name>Transmitting</name></location>
<location id="bus_coll"><name>Collided</name></location>
<init ref="bus_idle"/>
<transition><source ref="bus_idle"/><target ref="bus_active"/><label kind="synchronisation">begin?</label><label kind="assignment">c=0</label></transition>
<transition><source ref="bus_active"/><target ref="bus_coll"/><label kind="guard">c&lt;=1</label><label kind="synchronisation">begin?</label></transition>
<transition><source ref="bus_active"/><target ref="bus_tx"/><label kind="guard">c&gt;=1</label></transition>
<transition><source ref="bus_tx"/><target ref="bus_idle"/><label kind="synchronisation">end?</label></transition>
<transition><source ref="bus_coll"/><target ref="bus_idle"/><label kind="synchronisation">cd!</label></transition>
</template>
<template><name>S0</name>
<location id="s0_wait"><name>Wait</name></location>
<location id="s0_send"><name>Send</name><label kind="invariant">y0&lt;=4</label></location>
<location id="s0_retry"><name>Retry</name></location>
<init ref="s0_wait"/>
<transition><source ref="s0_wait"/><target ref="s0_send"/><label kind="synchronisation">begin!</label><label kind="assignment">y0=0</label></transition>
<transition><source ref="s0_send"/><target ref="s0_retry"/><label kind="synchronisation">cd?</label><label kind="assignment">y0=0</label></transition>
<transition><source ref="s0_send"/><target ref="s0_wait"/><label kind="guard">y0&gt;=4</label><label kind="synchronisation">end!</label></transition>
<transition><source ref="s0_retry"/><target ref="s0_wait"/><label kind="guard">y0&gt;=1</label></transition>
</template>
