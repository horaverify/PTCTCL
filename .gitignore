*.bak
*.orig
*.backup

# Deliberately untracked regression models -- see
# tests/models/liveness-regressions/README.md. Ignored so that a broad
# `git add -A tests` cannot re-add them; that has happened twice.
/tests/models/liveness-regressions/

# Sweep runtime artefacts (pid/pgid of a live driver, not results)
/benchmarks/results_complete/complete.pid
/benchmarks/results_complete/complete.pgid

